+++ b/src/win/fs-event.c
@@ -571,10 +571,14 @@ void uv__process_fs_event_req(uv_loop_t* loop, uv_req_t* req,
     FILE_STANDARD_INFO info;
     if (err == ERROR_ACCESS_DENIED &&
         handle->dirw != NULL &&
+#if TAZ_LEGACY_FALLBACKS
+        uv__file_standard_info(handle->dir_handle, &info) &&
+#else
         GetFileInformationByHandleEx(handle->dir_handle,
                                      FileStandardInfo,
                                      &info,
                                      sizeof(info)) &&
+#endif
         info.Directory &&
         info.DeletePending) {
       uv__convert_utf16_to_utf8(handle->dirw, -1, &filename);
diff --git a/src/win/fs.c b/src/win/fs.c
