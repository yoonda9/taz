--- a/src/win/winapi.c
+++ b/src/win/winapi.c
@@ -70,6 +70,7 @@ sNeedCurrentDirectoryForExePathW pNeedCurrentDirectoryForExePathW;
 sGetQueuedCompletionStatusEx pGetQueuedCompletionStatusEx;
 sCancelIoEx pCancelIoEx;
 sSetFileCompletionNotificationModes pSetFileCompletionNotificationModes;
+sRtlUpcaseUnicodeChar pRtlUpcaseUnicodeChar;
 
 /* LoadLibrary from the system directory only: XP has no
  * LOAD_LIBRARY_SEARCH_SYSTEM32, and a bare DLL name would search the
@@ -92,6 +93,35 @@ static HMODULE uv__load_system_library(const WCHAR* name) {
   return LoadLibraryW(path);
 }
 
+
+BOOL uv__file_standard_info(HANDLE file, FILE_STANDARD_INFO* info) {
+  FILE_STANDARD_INFORMATION nt_info;
+  IO_STATUS_BLOCK io_status;
+  NTSTATUS status;
+
+  if (pGetFileInformationByHandleEx != NULL)
+    return pGetFileInformationByHandleEx(file,
+                                         FileStandardInfo,
+                                         info,
+                                         sizeof(*info));
+
+  status = pNtQueryInformationFile(file,
+                                   &io_status,
+                                   &nt_info,
+                                   sizeof(nt_info),
+                                   FileStandardInformation);
+  if (!NT_SUCCESS(status)) {
+    SetLastError(pRtlNtStatusToDosError(status));
+    return FALSE;
+  }
+  info->AllocationSize = nt_info.AllocationSize;
+  info->EndOfFile = nt_info.EndOfFile;
+  info->NumberOfLinks = nt_info.NumberOfLinks;
+  info->DeletePending = nt_info.DeletePending;
+  info->Directory = nt_info.Directory;
+  return TRUE;
+}
+
 #endif
 void uv__winapi_init(void) {
   HMODULE ntdll_module;
@@ -201,6 +231,10 @@ void uv__winapi_init(void) {
     pGetSystemTimePreciseAsFileTime = (sGetSystemTimePreciseAsFileTime) GetProcAddress(kernel32_module, "GetSystemTimePreciseAsFileTime");
     pGetCurrentProcessorNumber = (sGetCurrentProcessorNumber) GetProcAddress(kernel32_module, "GetCurrentProcessorNumber");
     pCompareStringOrdinal = (sCompareStringOrdinal) GetProcAddress(kernel32_module, "CompareStringOrdinal");
+    pRtlUpcaseUnicodeChar = (sRtlUpcaseUnicodeChar) GetProcAddress(ntdll_module, "RtlUpcaseUnicodeChar");
+    if (pRtlUpcaseUnicodeChar == NULL) {
+      uv_fatal_error(GetLastError(), "GetProcAddress");
+    }
     pGetFinalPathNameByHandleW = (sGetFinalPathNameByHandleW) GetProcAddress(kernel32_module, "GetFinalPathNameByHandleW");
     pReOpenFile = (sReOpenFile) GetProcAddress(kernel32_module, "ReOpenFile");
     pCreateSymbolicLinkW = (sCreateSymbolicLinkW) GetProcAddress(kernel32_module, "CreateSymbolicLinkW");
diff --git a/src/win/winapi.h b/src/win/winapi.h
