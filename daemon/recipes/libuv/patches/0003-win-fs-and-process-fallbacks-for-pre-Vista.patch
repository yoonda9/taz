@@ -4895,5 +4897,10 @@ extern sNeedCurrentDirectoryForExePathW pNeedCurrentDirectoryForExePathW;
 extern sGetQueuedCompletionStatusEx pGetQueuedCompletionStatusEx;
 extern sCancelIoEx pCancelIoEx;
