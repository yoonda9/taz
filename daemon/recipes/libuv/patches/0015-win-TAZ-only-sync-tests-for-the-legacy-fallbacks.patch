diff --git a/test/test-barrier.c b/test/test-barrier.c
index 5e904c40bc4f05903f6dedb4f3b891c7f1607a39..23e3ae7bc7ce594d9afdcad78431f436850ed7c0 100644
--- a/test/test-barrier.c
+++ b/test/test-barrier.c
@@ -158,3 +158,57 @@ TEST_IMPL(barrier_serial_thread_single) {
   uv_barrier_destroy(&barrier);
   return 0;
 }
+#if TAZ_LEGACY_FALLBACKS
+
+
+/* Five parties through many rounds: each round broadcasts twice on the
+ * barrier's condition variable while parties of the next round queue up
+ * behind it, and exactly one party per round is the serial one. On Windows
+ * the process runs on one CPU.
+ */
+
+#define TAZ_BARRIER_PARTIES 5
+#define TAZ_BARRIER_ROUNDS 2000
+
+static uv_barrier_t taz_rounds_barrier;
+
+
+static void taz_rounds_worker(void* arg) {
+  int* serial;
+  int i;
+
+  serial = arg;
+  for (i = 0; i < TAZ_BARRIER_ROUNDS; i++)
+    if (uv_barrier_wait(&taz_rounds_barrier) > 0)
+      (*serial)++;
+}
+
+
+TEST_IMPL(taz_barrier_rounds) {
+  uv_thread_t threads[TAZ_BARRIER_PARTIES - 1];
+  int serial[TAZ_BARRIER_PARTIES];
+  int total;
+  int i;
+
+#ifdef _WIN32
+  ASSERT(SetProcessAffinityMask(GetCurrentProcess(), 1));
+#endif
+  memset(serial, 0, sizeof(serial));
+  ASSERT_OK(uv_barrier_init(&taz_rounds_barrier, TAZ_BARRIER_PARTIES));
+  for (i = 0; i < TAZ_BARRIER_PARTIES - 1; i++)
+    ASSERT_OK(uv_thread_create(&threads[i],
+                               taz_rounds_worker,
+                               &serial[i + 1]));
+  taz_rounds_worker(&serial[0]);
+  for (i = 0; i < TAZ_BARRIER_PARTIES - 1; i++)
+    ASSERT_OK(uv_thread_join(&threads[i]));
+  uv_barrier_destroy(&taz_rounds_barrier);
+
+  total = 0;
+  for (i = 0; i < TAZ_BARRIER_PARTIES; i++)
+    total += serial[i];
+  ASSERT_EQ(TAZ_BARRIER_ROUNDS, total);
+  return 0;
+}
+
+#endif  /* TAZ_LEGACY_FALLBACKS */
diff --git a/test/test-condvar.c b/test/test-condvar.c
index 2711f8cc1b3678794a3811cf14e381485da88259..5f74d8698a7bb36920017d945556607e228ac995 100644
--- a/test/test-condvar.c
+++ b/test/test-condvar.c
@@ -246,3 +246,82 @@ TEST_IMPL(condvar_5) {
 
   return 0;
 }
+#if TAZ_LEGACY_FALLBACKS
+
+
+/* Two threads hand a counter back and forth, each signalling and then waiting
+ * on the same condition variable, so every signal must wake the thread that
+ * was already waiting rather than the one that sent it, and a signal sent
+ * just after a waiter released the mutex must still reach it. Each round
+ * starts a new peer while the main thread holds the mutex, the start where a
+ * waiter is most often preempted between releasing the mutex and blocking;
+ * in every other round the peer's first wait times out while the main thread
+ * is queued, and must leave nothing behind for later signals to land on. On
+ * Windows the process runs on one CPU.
+ */
+
+#define TAZ_HANDOFF_ROUNDS 100
+#define TAZ_HANDOFFS 20
+
+static uv_mutex_t taz_handoff_mutex;
+static uv_cond_t taz_handoff_cond;
+static int taz_handoff_step;
+static int taz_handoff_timed;
+
+
+static void taz_handoff(void) {
+  int current;
+
+  taz_handoff_step++;
+  uv_cond_signal(&taz_handoff_cond);
+  current = taz_handoff_step;
+  while (current == taz_handoff_step)
+    uv_cond_wait(&taz_handoff_cond, &taz_handoff_mutex);
+}
+
+
+static void taz_handoff_peer(void* arg) {
+  int i;
+
+  (void) &arg;
+  uv_mutex_lock(&taz_handoff_mutex);
+  if (taz_handoff_timed)
+    ASSERT_EQ(UV_ETIMEDOUT,
+              uv_cond_timedwait(&taz_handoff_cond, &taz_handoff_mutex, 0));
+  for (i = 0; i < TAZ_HANDOFFS - 1; i++)
+    taz_handoff();
+  taz_handoff_step++;
+  uv_cond_signal(&taz_handoff_cond);
+  uv_mutex_unlock(&taz_handoff_mutex);
+}
+
+
+TEST_IMPL(taz_cond_handoff) {
+  uv_thread_t thread;
+  int round;
+  int i;
+
+#ifdef _WIN32
+  ASSERT(SetProcessAffinityMask(GetCurrentProcess(), 1));
+#endif
+  ASSERT_OK(uv_mutex_init(&taz_handoff_mutex));
+  ASSERT_OK(uv_cond_init(&taz_handoff_cond));
+
+  for (round = 0; round < TAZ_HANDOFF_ROUNDS; round++) {
+    taz_handoff_step = 0;
+    taz_handoff_timed = round % 2;
+    uv_mutex_lock(&taz_handoff_mutex);
+    ASSERT_OK(uv_thread_create(&thread, taz_handoff_peer, NULL));
+    for (i = 0; i < TAZ_HANDOFFS; i++)
+      taz_handoff();
+    ASSERT_EQ(2 * TAZ_HANDOFFS, taz_handoff_step);
+    uv_mutex_unlock(&taz_handoff_mutex);
+    ASSERT_OK(uv_thread_join(&thread));
+  }
+
+  uv_cond_destroy(&taz_handoff_cond);
+  uv_mutex_destroy(&taz_handoff_mutex);
+  return 0;
+}
+
+#endif  /* TAZ_LEGACY_FALLBACKS */
