+  TEST_ENTRY  (taz_rwlock_readers_share)
+  TEST_ENTRY  (taz_cond_handoff)
+  TEST_ENTRY  (taz_barrier_rounds)
+#endif
   TEST_ENTRY  (thread_equal)
   TEST_ENTRY  (thread_affinity)
   TEST_ENTRY  (thread_priority)
diff --git a/test/test-mutexes.c b/test/test-mutexes.c
index ca3377324b2eab6840c4af0680cef54a0f43ac16..f82155aa07021c441b5e3b694ae3a1f9350ace0c 100644
--- a/test/test-mutexes.c
+++ b/test/test-mutexes.c
@@ -180,3 +180,124 @@ TEST_IMPL(thread_rwlock_trylock) {
 
   return 0;
 }
+#if TAZ_LEGACY_FALLBACKS
+
+
+/* The fallback primitives own kernel handles that upstream's do not, so a
+ * create, use and destroy cycle must leave the handle count where it was.
+ */
+
+#ifdef _WIN32
+#define TAZ_HANDLE_ROUNDS 200
+
+static void taz_sync_cycle(void) {
+  uv_cond_t cond;
+  uv_mutex_t mtx;
+  uv_rwlock_t lock;
+
+  ASSERT_OK(uv_cond_init(&cond));
+  ASSERT_OK(uv_mutex_init(&mtx));
+  ASSERT_OK(uv_rwlock_init(&lock));
+
+  uv_cond_signal(&cond);
+  uv_cond_broadcast(&cond);
+  uv_mutex_lock(&mtx);
+  ASSERT_EQ(UV_ETIMEDOUT, uv_cond_timedwait(&cond, &mtx, 0));
+  uv_mutex_unlock(&mtx);
+
+  uv_rwlock_rdlock(&lock);
+  uv_rwlock_rdunlock(&lock);
+  uv_rwlock_wrlock(&lock);
+  uv_rwlock_wrunlock(&lock);
+
+  uv_rwlock_destroy(&lock);
+  uv_mutex_destroy(&mtx);
+  uv_cond_destroy(&cond);
+}
+#endif
+
+
+TEST_IMPL(taz_sync_handles_balanced) {
+#ifdef _WIN32
+  DWORD before;
+  DWORD after;
+  int i;
+
+  /* First use may create process-wide handles. */
+  taz_sync_cycle();
+
+  ASSERT(GetProcessHandleCount(GetCurrentProcess(), &before));
+  for (i = 0; i < TAZ_HANDLE_ROUNDS; i++)
+    taz_sync_cycle();
+  ASSERT(GetProcessHandleCount(GetCurrentProcess(), &after));
+
+  ASSERT_EQ(before, after);
+  return 0;
+#else
+  RETURN_SKIP("Handle counts are a Windows notion.");
+#endif
+}
+
+
+/* Two readers inside the lock at once, the second through the blocking
+ * uv_rwlock_rdlock, and the try-locks against the other mode.
+ */
+
+static uv_rwlock_t taz_share_lock;
+static uv_sem_t taz_share_in;
+static uv_sem_t taz_share_go;
+
+
+static void taz_share_peer(void* arg) {
+  (void) &arg;
+  uv_rwlock_rdlock(&taz_share_lock);
+  uv_sem_post(&taz_share_in);
+  uv_sem_wait(&taz_share_go);
+  uv_rwlock_rdunlock(&taz_share_lock);
+}
+
+
+TEST_IMPL(taz_rwlock_readers_share) {
+  uv_thread_t thread;
+  int waited;
+
+  ASSERT_OK(uv_rwlock_init(&taz_share_lock));
+  ASSERT_OK(uv_sem_init(&taz_share_in, 0));
+  ASSERT_OK(uv_sem_init(&taz_share_go, 0));
+
+  uv_rwlock_rdlock(&taz_share_lock);
+  ASSERT_OK(uv_thread_create(&thread, taz_share_peer, NULL));
+
+  /* The peer must get in while this thread still holds a read lock. */
+  for (waited = 0; waited < 2000; waited += 10) {
+    if (uv_sem_trywait(&taz_share_in) == 0)
+      break;
+    uv_sleep(10);
+  }
+  ASSERT_LT(waited, 2000);
+
+  /* Both readers are in: a writer is refused, another reader is not. */
+  ASSERT_EQ(UV_EBUSY, uv_rwlock_trywrlock(&taz_share_lock));
+  ASSERT_OK(uv_rwlock_tryrdlock(&taz_share_lock));
+  uv_rwlock_rdunlock(&taz_share_lock);
+
+  /* The peer alone still holds it. */
+  uv_rwlock_rdunlock(&taz_share_lock);
+  ASSERT_EQ(UV_EBUSY, uv_rwlock_trywrlock(&taz_share_lock));
+
+  uv_sem_post(&taz_share_go);
+  ASSERT_OK(uv_thread_join(&thread));
+
+  /* Free again, and a writer excludes both modes. */
+  ASSERT_OK(uv_rwlock_trywrlock(&taz_share_lock));
+  ASSERT_EQ(UV_EBUSY, uv_rwlock_tryrdlock(&taz_share_lock));
+  ASSERT_EQ(UV_EBUSY, uv_rwlock_trywrlock(&taz_share_lock));
+  uv_rwlock_wrunlock(&taz_share_lock);
+
+  uv_sem_destroy(&taz_share_go);
+  uv_sem_destroy(&taz_share_in);
+  uv_rwlock_destroy(&taz_share_lock);
+  return 0;
+}
+
+#endif  /* TAZ_LEGACY_FALLBACKS */
diff --git a/test/test-thread.c b/test/test-thread.c
index 819bbd5c92399df78602c89961de0c66ac4f1ba1..2e019c2d48d2a8e692590a6535133c3fde3397ca 100644
--- a/test/test-thread.c
+++ b/test/test-thread.c
@@ -304,3 +304,64 @@ TEST_IMPL(thread_detach) {
 
   return 0;
 }
+#if TAZ_LEGACY_FALLBACKS
+
+
+/* uv_once raced by several threads: the callback runs once and no caller
+ * returns before it has finished.
+ */
+
+#define TAZ_ONCE_THREADS 8
+
+static uv_once_t taz_once_guard = UV_ONCE_INIT;
+static uv_sem_t taz_once_gate;
+static volatile int taz_once_calls;
+static volatile int taz_once_done;
+static volatile int taz_once_early_return;
+
+
+static void taz_once_cb(void) {
+  taz_once_calls++;
+  uv_sleep(50);
+  taz_once_done = 1;
+}
+
+
+static void taz_once_thread(void* arg) {
+  (void) &arg;
+  uv_sem_wait(&taz_once_gate);
+  uv_once(&taz_once_guard, taz_once_cb);
+  if (taz_once_done != 1)
+    taz_once_early_return = 1;
+}
+
+
+TEST_IMPL(taz_once_race) {
+  uv_thread_t threads[TAZ_ONCE_THREADS];
+  int i;
+
+  ASSERT_OK(uv_sem_init(&taz_once_gate, 0));
+  for (i = 0; i < TAZ_ONCE_THREADS; i++)
+    ASSERT_OK(uv_thread_create(&threads[i], taz_once_thread, NULL));
+
+  /* Let every thread block on the gate, then release them together. */
+  uv_sleep(100);
+  for (i = 0; i < TAZ_ONCE_THREADS; i++)
+    uv_sem_post(&taz_once_gate);
+
+  for (i = 0; i < TAZ_ONCE_THREADS; i++)
+    ASSERT_OK(uv_thread_join(&threads[i]));
+
+  ASSERT_EQ(1, taz_once_calls);
+  ASSERT_EQ(1, taz_once_done);
+  ASSERT_OK(taz_once_early_return);
+
+  /* A later call on the same guard must not run the callback again. */
+  uv_once(&taz_once_guard, taz_once_cb);
+  ASSERT_EQ(1, taz_once_calls);
+
+  uv_sem_destroy(&taz_once_gate);
+  return 0;
+}
+
+#endif  /* TAZ_LEGACY_FALLBACKS */
diff --git a/test/test-threadpool.c b/test/test-threadpool.c
index fb5e5732e6aa340028ce2e48e7e47443fe1331db..f47bb067242c47a49781bde5056fbeec97903f16 100644
--- a/test/test-threadpool.c
+++ b/test/test-threadpool.c
@@ -74,3 +74,72 @@ TEST_IMPL(threadpool_queue_work_einval) {
   MAKE_VALGRIND_HAPPY(uv_default_loop());
   return 0;
 }
+#if TAZ_LEGACY_FALLBACKS
+
+
+/* Many rounds of queued work on a pool of several threads: workers go idle in
+ * uv_cond_wait between rounds and every uv_cond_signal has to wake one.
+ */
+
+#ifdef _WIN32
+# define putenv _putenv
+#endif
+
+#define TAZ_STRESS_ITEMS 64
+#define TAZ_STRESS_ROUNDS 50
+#define TAZ_STRESS_LIMIT_NS (30ULL * 1000 * 1000 * 1000)
+
+static char taz_stress_pool_size[] = "UV_THREADPOOL_SIZE=8";
+static uv_work_t taz_stress_reqs[TAZ_STRESS_ITEMS];
+static int taz_stress_after_count;
+
+
+static void taz_stress_work_cb(uv_work_t* req) {
+  volatile int spin;
+  int i;
+
+  i = (int) (uintptr_t) req->data;
+  for (spin = 0; spin < 1000; spin++);
+  /* An occasional pause lets workers drain the queue and go idle. */
+  if (i % 8 == 0)
+    uv_sleep(1);
+}
+
+
+static void taz_stress_after_cb(uv_work_t* req, int status) {
+  (void) &req;
+  ASSERT_OK(status);
+  taz_stress_after_count++;
+}
+
+
+TEST_IMPL(taz_threadpool_wait_wake_stress) {
+  uint64_t start;
+  int round;
+  int i;
+
+  /* The runner gives each test its own process, so nothing has started the
+   * pool yet and the size is still read from the environment. The pool reads
+   * it with getenv, which on Windows does not see uv_os_setenv.
+   */
+  ASSERT_OK(putenv(taz_stress_pool_size));
+
+  start = uv_hrtime();
+  for (round = 0; round < TAZ_STRESS_ROUNDS; round++) {
+    for (i = 0; i < TAZ_STRESS_ITEMS; i++) {
+      taz_stress_reqs[i].data = (void*) (uintptr_t) i;
+      ASSERT_OK(uv_queue_work(uv_default_loop(),
+                              &taz_stress_reqs[i],
+                              taz_stress_work_cb,
+                              taz_stress_after_cb));
+    }
+    ASSERT_OK(uv_run(uv_default_loop(), UV_RUN_DEFAULT));
+    ASSERT_EQ((round + 1) * TAZ_STRESS_ITEMS, taz_stress_after_count);
+  }
+  ASSERT_LT(uv_hrtime() - start, TAZ_STRESS_LIMIT_NS);
+
+  MAKE_VALGRIND_HAPPY(uv_default_loop());
+  return 0;
+}
+
+#endif  /* TAZ_LEGACY_FALLBACKS */
