From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Yoon <5332544+yoonda9@users.noreply.github.com>
Date: Sat, 24 Oct 2026 17:41:41 +0000
Subject: [PATCH] win: lookup-only wiring for I/O, SRW and condvar calls

Routes the functions that have no fallback yet through the run-time
pointers added in the lookup patch: GetQueuedCompletionStatusEx in
uv__poll, CancelIoEx in tcp.c and pipe.c,
SetFileCompletionNotificationModes in tcp.c and udp.c, the seven SRW
lock functions and the condition-variable functions in thread.c.
uv_rwlock_init and uv_cond_init call uv__once_init first because they
are usable before any loop exists. The pointers are fatal-at-init when
missing, so no call goes through NULL. Behaviour is unchanged where
they resolve. Fallbacks follow in later steps (I/O path, sync
primitives); this is the mechanism of a7493d8a run in reverse.
---
 src/win/core.c   |  4 ++++
 src/win/pipe.c   |  8 ++++++++
 src/win/tcp.c    | 12 ++++++++++++
 src/win/thread.c | 50 ++++++++++++++++++++++++++++++++++++++++++++++++
 src/win/udp.c    |  4 ++++
 5 files changed, 78 insertions(+)

diff --git a/src/win/core.c b/src/win/core.c
index 5f41c87ad5ed137c51b43e4941414c89ddff5216..4ff67905a062670db4c4f805f9ec17d1676619ed 100644
--- a/src/win/core.c
+++ b/src/win/core.c
@@ -462,7 +462,11 @@ static void uv__poll(uv_loop_t* loop, DWORD timeout) {
      */
     lfields->current_timeout = timeout;
 
+#if TAZ_LEGACY_FALLBACKS
+    success = pGetQueuedCompletionStatusEx(loop->iocp,
+#else
     success = GetQueuedCompletionStatusEx(loop->iocp,
+#endif
                                           overlappeds,
                                           ARRAY_SIZE(overlappeds),
                                           &count,
diff --git a/src/win/pipe.c b/src/win/pipe.c
index 8c45f804d195fd6559a54cd7390adc2d96f01129..d9d3f85fea2594825ad24ca67313c6990bcdf757 100644
--- a/src/win/pipe.c
+++ b/src/win/pipe.c
@@ -1009,7 +1009,11 @@ void uv__pipe_interrupt_read(uv_pipe_t* handle) {
 
   if (!(handle->flags & UV_HANDLE_NON_OVERLAPPED_PIPE)) {
     /* Cancel asynchronous read. */
+#if TAZ_LEGACY_FALLBACKS
+    r = pCancelIoEx(handle->handle, &handle->read_req.u.io.overlapped);
+#else
     r = CancelIoEx(handle->handle, &handle->read_req.u.io.overlapped);
+#endif
     assert(r || GetLastError() == ERROR_NOT_FOUND);
     (void) r;
   } else {
@@ -2028,7 +2032,11 @@ static int uv__pipe_read_data(uv_loop_t* loop,
       r = GetLastError();
       *bytes_read = 0;
       if (r == ERROR_IO_PENDING) {
+#if TAZ_LEGACY_FALLBACKS
+        r = pCancelIoEx(handle->handle, &req->u.io.overlapped);
+#else
         r = CancelIoEx(handle->handle, &req->u.io.overlapped);
+#endif
         assert(r || GetLastError() == ERROR_NOT_FOUND);
         if (GetOverlappedResult(handle->handle, &req->u.io.overlapped, bytes_read, TRUE)) {
           r = ERROR_SUCCESS;
diff --git a/src/win/tcp.c b/src/win/tcp.c
index c452c12e8f06f13e519a198f786eec63faebe2bf..2cb00753168b56319f7dbd1db91eb28914889e65 100644
--- a/src/win/tcp.c
+++ b/src/win/tcp.c
@@ -119,7 +119,11 @@ static int uv__tcp_set_socket(uv_loop_t* loop,
   if (!(handle->flags & UV_HANDLE_EMULATE_IOCP) && !non_ifs_lsp) {
     UCHAR sfcnm_flags =
         FILE_SKIP_SET_EVENT_ON_HANDLE | FILE_SKIP_COMPLETION_PORT_ON_SUCCESS;
+#if TAZ_LEGACY_FALLBACKS
+    if (!pSetFileCompletionNotificationModes((HANDLE) socket, sfcnm_flags))
+#else
     if (!SetFileCompletionNotificationModes((HANDLE) socket, sfcnm_flags))
+#endif
       return GetLastError();
     handle->flags |= UV_HANDLE_SYNC_BYPASS_IOCP;
   }
@@ -1403,7 +1407,11 @@ static void uv__tcp_try_cancel_reqs(uv_tcp_t* tcp) {
   /* TODO: in libuv v2, keep explicit track of write_reqs, so we can cancel
    * them each explicitly with CancelIoEx (like unix). */
   if (reading)
+#if TAZ_LEGACY_FALLBACKS
+    pCancelIoEx((HANDLE) socket, &tcp->read_req.u.io.overlapped);
+#else
     CancelIoEx((HANDLE) socket, &tcp->read_req.u.io.overlapped);
+#endif
   if (writing)
     CancelIo((HANDLE) socket);
 
@@ -1433,7 +1441,11 @@ static void uv__tcp_try_cancel_reqs(uv_tcp_t* tcp) {
 
   if (socket != tcp->socket) {
     if (reading)
+#if TAZ_LEGACY_FALLBACKS
+      pCancelIoEx((HANDLE) socket, &tcp->read_req.u.io.overlapped);
+#else
       CancelIoEx((HANDLE) socket, &tcp->read_req.u.io.overlapped);
+#endif
     if (writing)
       CancelIo((HANDLE) socket);
   }
diff --git a/src/win/thread.c b/src/win/thread.c
index 125ecbbe3bf26c24e9df547c2674b9e1d5a0dda2..e5a7f13bd6f10f6623fbd93a7e04e48fcff70d29 100644
--- a/src/win/thread.c
+++ b/src/win/thread.c
@@ -441,7 +441,12 @@ STATIC_ASSERT(sizeof(uv_rwlock_t) == 48);
 
 int uv_rwlock_init(uv_rwlock_t* rwlock) {
   memset(rwlock, 0, sizeof(*rwlock));
+#if TAZ_LEGACY_FALLBACKS
+  uv__once_init();
+  pInitializeSRWLock(&rwlock->read_write_lock_);
+#else
   InitializeSRWLock(&rwlock->read_write_lock_);
+#endif
 
   return 0;
 }
@@ -454,12 +459,20 @@ void uv_rwlock_destroy(uv_rwlock_t* rwlock) {
 
 
 void uv_rwlock_rdlock(uv_rwlock_t* rwlock) {
+#if TAZ_LEGACY_FALLBACKS
+  pAcquireSRWLockShared(&rwlock->read_write_lock_);
+#else
   AcquireSRWLockShared(&rwlock->read_write_lock_);
+#endif
 }
 
 
 int uv_rwlock_tryrdlock(uv_rwlock_t* rwlock) {
+#if TAZ_LEGACY_FALLBACKS
+  if (!pTryAcquireSRWLockShared(&rwlock->read_write_lock_))
+#else
   if (!TryAcquireSRWLockShared(&rwlock->read_write_lock_))
+#endif
     return UV_EBUSY;
 
   return 0;
@@ -467,17 +480,29 @@ int uv_rwlock_tryrdlock(uv_rwlock_t* rwlock) {
 
 
 void uv_rwlock_rdunlock(uv_rwlock_t* rwlock) {
+#if TAZ_LEGACY_FALLBACKS
+  pReleaseSRWLockShared(&rwlock->read_write_lock_);
+#else
   ReleaseSRWLockShared(&rwlock->read_write_lock_);
+#endif
 }
 
 
 void uv_rwlock_wrlock(uv_rwlock_t* rwlock) {
+#if TAZ_LEGACY_FALLBACKS
+  pAcquireSRWLockExclusive(&rwlock->read_write_lock_);
+#else
   AcquireSRWLockExclusive(&rwlock->read_write_lock_);
+#endif
 }
 
 
 int uv_rwlock_trywrlock(uv_rwlock_t* rwlock) {
+#if TAZ_LEGACY_FALLBACKS
+  if (!pTryAcquireSRWLockExclusive(&rwlock->read_write_lock_))
+#else
   if (!TryAcquireSRWLockExclusive(&rwlock->read_write_lock_))
+#endif
     return UV_EBUSY;
 
   return 0;
@@ -485,7 +510,11 @@ int uv_rwlock_trywrlock(uv_rwlock_t* rwlock) {
 
 
 void uv_rwlock_wrunlock(uv_rwlock_t* rwlock) {
+#if TAZ_LEGACY_FALLBACKS
+  pReleaseSRWLockExclusive(&rwlock->read_write_lock_);
+#else
   ReleaseSRWLockExclusive(&rwlock->read_write_lock_);
+#endif
 }
 
 
@@ -531,7 +560,12 @@ int uv_sem_trywait(uv_sem_t* sem) {
 
 
 int uv_cond_init(uv_cond_t* cond) {
+#if TAZ_LEGACY_FALLBACKS
+  uv__once_init();
+  pInitializeConditionVariable(&cond->cond_var);
+#else
   InitializeConditionVariable(&cond->cond_var);
+#endif
   return 0;
 }
 
@@ -543,23 +577,39 @@ void uv_cond_destroy(uv_cond_t* cond) {
 
 
 void uv_cond_signal(uv_cond_t* cond) {
+#if TAZ_LEGACY_FALLBACKS
+  pWakeConditionVariable(&cond->cond_var);
+#else
   WakeConditionVariable(&cond->cond_var);
+#endif
 }
 
 
 void uv_cond_broadcast(uv_cond_t* cond) {
+#if TAZ_LEGACY_FALLBACKS
+  pWakeAllConditionVariable(&cond->cond_var);
+#else
   WakeAllConditionVariable(&cond->cond_var);
+#endif
 }
 
 
 void uv_cond_wait(uv_cond_t* cond, uv_mutex_t* mutex) {
+#if TAZ_LEGACY_FALLBACKS
+  if (!pSleepConditionVariableCS(&cond->cond_var, mutex, INFINITE))
+#else
   if (!SleepConditionVariableCS(&cond->cond_var, mutex, INFINITE))
+#endif
     abort();
 }
 
 
 int uv_cond_timedwait(uv_cond_t* cond, uv_mutex_t* mutex, uint64_t timeout) {
+#if TAZ_LEGACY_FALLBACKS
+  if (pSleepConditionVariableCS(&cond->cond_var, mutex, (DWORD)(timeout / 1e6)))
+#else
   if (SleepConditionVariableCS(&cond->cond_var, mutex, (DWORD)(timeout / 1e6)))
+#endif
     return 0;
   if (GetLastError() != ERROR_TIMEOUT)
     abort();
