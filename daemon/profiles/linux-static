# Partial Conan host profile for Linux, composed after a detected base profile
# (`default`, or `clang` for the linux-clang-* presets; both created by
# `just setup`). It pins only what detection cannot: every dependency is built
# as a static library, and the C++ standard used for gtest.
#
# The fully static (musl) release build arrives in Step 13.
[settings]
# Match the Windows profile so dependency package ids agree across platforms.
compiler.cppstd=17

[options]
*:shared=False

[conf]
# Must match the generator in daemon/CMakePresets.json.
tools.cmake.cmaketoolchain:generator=Ninja
