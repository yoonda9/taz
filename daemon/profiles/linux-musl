# Complete Conan host profile for linux-musl-release — unlike every other
# Linux profile here, it is not composed after a detected base profile
# (`default`), because the Bootlin musl toolchain is a compiler `default`
# knows nothing about.
#
# This preset gets its own Conan home (tools/dev.py's conan_env sets
# CONAN_HOME to <cache root>/conan-musl) so its from-source musl packages can
# never satisfy, or be satisfied by, the glibc packages in ~/.conan2: Conan
# package ids cover neither the libc nor [conf] keys such as
# compiler_executables. Only this preset links tazd against musl; every
# other Linux preset still links glibc dynamically (daemon/profiles/
# linux-static).
#
# tools/dev.py sets TAZ_MUSL_TOOLCHAIN to the toolchain directory (fetching
# it first if needed) before every Conan invocation on this preset; an unset
# variable would render "None/bin/..." below.
[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=17

[options]
*:shared=False

[conf]
# Must match the generator in daemon/CMakePresets.json.
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "{{ os.getenv('TAZ_MUSL_TOOLCHAIN') }}/bin/x86_64-linux-gcc", "cpp": "{{ os.getenv('TAZ_MUSL_TOOLCHAIN') }}/bin/x86_64-linux-g++"}
# A fully static tazd: no INTERP, no NEEDED (verified by `just verify-static`).
tools.build:exelinkflags=["-static"]
