# Partial Conan host profile for Windows (MSVC), composed after the detected
# `default` profile (created by `just setup`; Conan finds MSVC via vswhere).
#
# compiler.runtime=static selects /MT (Release) or /MTd (Debug) via the
# auto-derived runtime_type, matching CMAKE_MSVC_RUNTIME_LIBRARY in
# CMakeLists.txt. All dependencies are built as static libraries.
[settings]
compiler.runtime=static
# gtest >= 1.17 requires C++17; Conan's Windows detection defaults to 14.
compiler.cppstd=17

[options]
*:shared=False

[conf]
# Must match the generator in daemon/CMakePresets.json. Without it Conan's
# toolchain assumes Visual Studio and emits CMAKE_GENERATOR_PLATFORM/TOOLSET,
# which Ninja rejects.
tools.cmake.cmaketoolchain:generator=Ninja
