# Only what this repo generates. Build trees live under build/ (CMake presets,
# Conan output) and reports under out/.

# Build and report output
build/
out/
dist/
compile_commands.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*

# Editor and tool caches (clangd keeps its index in .cache/)
.cache/

# A developer's own CMake presets; daemon/CMakePresets.json is the shared one
CMakeUserPresets.json

# Local environment files may hold secrets
.env
.envrc

# Agent planning: only .agents/planning/ is versioned (the negations also
# override a global ignore of .agents/)
!.agents/
.agents/*
!.agents/planning/

# ralph orchestrator runtime state; its long-term memories.md is versioned
.ralph/*
!.ralph/agent/
.ralph/agent/*
!.ralph/agent/memories.md
