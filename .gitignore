# Only what this repo generates. Build trees live under build/ (CMake presets,
# Conan output) and reports under out/.

# Build and report output
build/
out/
dist/
compile_commands.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*

# Editor and tool caches (clangd keeps its index in .cache/)
.cache/

# A developer's own CMake presets; daemon/CMakePresets.json is the shared one
CMakeUserPresets.json

# Local environment files may hold secrets
.env
.envrc

# Local agent and code-index state: planning notes, orchestrator runs and
# memories stay on each developer's machine
.agents/
.ralph/
.cgcignore
