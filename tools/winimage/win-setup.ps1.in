# First-logon setup for the Windows build template. Runs once, as the local
# admin account autounattend.xml creates. tools/winbuild.py fills in the
# placeholders when it builds the answer ISO.
$ErrorActionPreference = 'Continue'
Start-Transcript -Path "$env:SystemRoot\Temp\win-setup.log" -Append

function Find-OnDrives([string]$relative) {
    Get-PSDrive -PSProvider FileSystem |
        ForEach-Object { Join-Path $_.Root $relative } |
        Where-Object { Test-Path $_ } |
        Select-Object -First 1
}

# 1. VirtIO drivers + QEMU guest agent (lets Proxmox report the VM's IP).
$tools = Find-OnDrives 'virtio-win-guest-tools.exe'
if ($tools) {
    Write-Output "installing $tools"
    Start-Process -FilePath $tools -ArgumentList '/install', '/quiet', '/norestart' -Wait
} else {
    $msi = Find-OnDrives 'virtio-win-gt-x64.msi'
    if ($msi) { Start-Process msiexec.exe -ArgumentList '/i', "`"$msi`"", '/qn', '/norestart' -Wait }
    $ga = Find-OnDrives 'guest-agent\qemu-ga-x86_64.msi'
    if ($ga) { Start-Process msiexec.exe -ArgumentList '/i', "`"$ga`"", '/qn', '/norestart' -Wait }
}

# 2. OpenSSH server; administrators log in with the build key.
if (-not (Get-Service sshd -ErrorAction SilentlyContinue)) {
    Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0
}
New-Item -Force -Path 'HKLM:\SOFTWARE\OpenSSH' | Out-Null
New-ItemProperty -Force -Path 'HKLM:\SOFTWARE\OpenSSH' -Name DefaultShell -PropertyType String `
    -Value "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" | Out-Null
$keys = Join-Path $env:ProgramData 'ssh\administrators_authorized_keys'
New-Item -ItemType Directory -Force -Path (Split-Path $keys) | Out-Null
Set-Content -Path $keys -Value '@@PUBKEY@@' -Encoding ascii
icacls.exe $keys /inheritance:r /grant 'Administrators:F' /grant 'SYSTEM:F'
Set-Service sshd -StartupType Automatic
Start-Service sshd
if (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue) {
    Set-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -Enabled True -Profile Any
} else {
    New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server (sshd)' `
        -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 -Profile Any
}
Get-NetFirewallRule -Name 'FPS-ICMP4-ERQ-In*' -ErrorAction SilentlyContinue | Enable-NetFirewallRule
Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue

# 3. Long paths (Conan and nested build trees), and no automatic update reboots.
Set-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem' -Name LongPathsEnabled -Value 1 -Type DWord
$au = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU'
New-Item -Force -Path $au | Out-Null
Set-ItemProperty $au -Name NoAutoRebootWithLoggedOnUsers -Value 1 -Type DWord
Set-ItemProperty $au -Name AUOptions -Value 2 -Type DWord

# 4. Lab password policy: the fixed password is deliberately simple, and a
# template is cloned for months, so passwords must neither need complexity
# nor expire (the default is 42 days).
$policy = Join-Path $env:TEMP 'secpol.cfg'
secedit.exe /export /cfg $policy /areas SECURITYPOLICY | Out-Null
(Get-Content $policy) -replace '^PasswordComplexity\s*=.*', 'PasswordComplexity = 0' |
    Set-Content $policy
secedit.exe /configure /db "$env:SystemRoot\security\local.sdb" /cfg $policy /areas SECURITYPOLICY | Out-Null
Remove-Item $policy -Force
net.exe accounts /minpwlen:0 /maxpwage:unlimited | Out-Null
foreach ($name in '@@USER@@', 'Administrator') { Set-LocalUser -Name $name -PasswordNeverExpires $true }

# 5. Turn automatic logon back off and drop the stored password.
$winlogon = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
Set-ItemProperty $winlogon -Name AutoAdminLogon -Value '0'
Remove-ItemProperty $winlogon -Name DefaultPassword -ErrorAction SilentlyContinue

Set-Content -Path "$env:SystemRoot\Temp\win-setup.done" -Value (Get-Date -Format o)
Stop-Transcript
