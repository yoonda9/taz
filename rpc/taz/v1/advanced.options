# nanopb size limits for advanced.proto (reference C daemon only).
taz.v1.RunAsRequest.user               max_size:64
taz.v1.RunAsResponse.effective_user    max_size:64

taz.v1.LogRequest.level                max_size:8
taz.v1.LogEntry.level                  max_size:8
taz.v1.LogEntry.message                max_size:512
# ~530 B per entry; 64 entries per frame stay well under the 64 KiB cap.
taz.v1.LogResponse.entries             max_count:64

# The serialized result is emitted from the task's stored buffer.
taz.v1.TaskStatusResponse.result       type:FT_CALLBACK

taz.v1.TaskState                       packed_enum:true
