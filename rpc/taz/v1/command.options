# nanopb size limits for command.proto (reference C daemon only).
# CommandExecRequest is ~40 KiB when statically sized; allocate it on the heap.
taz.v1.CommandExecRequest.command      max_size:1024
taz.v1.CommandExecRequest.args         max_count:32 max_size:512
taz.v1.CommandExecRequest.env          max_count:32
taz.v1.CommandExecRequest.working_dir  max_size:1024
taz.v1.CommandExecRequest.as_user      max_size:64

# Output is streamed from the daemon's own buffers via encode callbacks rather
# than copied into a fixed-size struct.
taz.v1.CommandExecResponse.stdout      type:FT_CALLBACK
taz.v1.CommandExecResponse.stderr      type:FT_CALLBACK
