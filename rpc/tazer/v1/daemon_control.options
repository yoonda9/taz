# nanopb size limits for daemon_control.proto (reference C daemon only).
tazer.v1.VersionResponse.version              max_size:32
tazer.v1.VersionResponse.build                max_size:64
tazer.v1.VersionResponse.platform             max_size:32

# CAPABILITY payload is capped at 1 KiB on the wire.
tazer.v1.CapabilityPayload.operations         max_count:64
tazer.v1.CapabilityPayload.max_payload_sizes  max_count:8
tazer.v1.CapabilityPayload.compression        max_count:4 max_size:16

tazer.v1.ConfigurationGetRequest.keys         max_count:32 max_size:128
tazer.v1.ConfigurationGetResponse.config      max_count:32
tazer.v1.ConfigurationUpdateRequest.config    max_count:32
tazer.v1.ConfigurationUpdateResponse.applied  max_count:32 max_size:128
tazer.v1.ConfigurationUpdateResponse.rejected max_count:32
tazer.v1.RejectedKey.key                      max_size:128
tazer.v1.RejectedKey.reason                   max_size:256
